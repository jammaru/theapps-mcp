{
  "name": "apps-mcp-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/write-analytics-id.mjs && node scripts/collect-font-glyphs.mjs && node scripts/subset-fonts.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "node scripts/write-analytics-id.mjs && astro check",
    "lint": "node scripts/write-analytics-id.mjs && astro check",
    "test": "node --experimental-strip-types --test src/lib/analytics.test.ts",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "deploy": "astro build && wrangler pages deploy dist --project-name=theapps-mcp",
    "preview:cf": "astro build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.121.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3"
  }
}
