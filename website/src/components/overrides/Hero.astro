---
import LandingHero from '../LandingHero.astro';
import Default from '@astrojs/starlight/components/Hero.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/' || path === '/en';
---

{
	isHome ? (
		<LandingHero />
	) : (
		<Default>
			<slot />
		</Default>
	)
}
