---
const word = 'Apps-mcp';
---

<div class="hero-logo-panel" aria-hidden="true">
	<svg class="hero-logo-svg" viewBox="0 0 640 640" role="img" aria-label="Apps-mcp">
		<rect class="hero-logo-bg" width="640" height="640" rx="48"></rect>
		<text
			class="hero-logo-text"
			x="320"
			y="340"
			text-anchor="middle"
			font-family="var(--font-outfit), Outfit, Arial, sans-serif"
			font-size="92"
			font-weight="700"
			letter-spacing="-0.04em">{word}</text>
	</svg>
</div>
