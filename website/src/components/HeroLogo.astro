---
const word = 'Apps-mcp';
---

<div class="hero-logo-panel" aria-hidden="true">
	<svg class="hero-logo-svg" viewBox="0 0 640 640" role="img" aria-label="Apps-mcp">
		<rect width="640" height="640" fill="#ffffff"></rect>
		<text
			x="320"
			y="340"
			text-anchor="middle"
			font-family="Outfit, IBM Plex Sans JP, Arial, sans-serif"
			font-size="92"
			font-weight="700"
			letter-spacing="-0.04em"
			fill="#0b0b0b">{word}</text>
	</svg>
</div>
