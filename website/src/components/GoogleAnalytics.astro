---
/**
 * Optional GA4. Enabled only when PUBLIC_GOOGLE_ANALYTICS_ID is set at build time.
 * Forks without the env var send nothing to the original property.
 *
 * The ID is written by scripts/write-analytics-id.mjs from process.env so Cloudflare
 * Pages + wrangler.jsonc still pick it up (dashboard plaintext vars are ignored).
 */
import { resolveGoogleAnalyticsId } from '../lib/analytics';
import analyticsId from '../lib/analytics-id.json';

const gaId = resolveGoogleAnalyticsId(analyticsId.id);
---

{
	gaId && (
		<script is:inline define:vars={{ gaId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', gaId);

			let started = false;
			const boot = () => {
				if (started) return;
				started = true;
				const script = document.createElement('script');
				script.async = true;
				script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
				document.head.appendChild(script);
			};

			const onInteract = () => boot();
			for (const type of ['pointerdown', 'keydown', 'scroll']) {
				window.addEventListener(type, onInteract, { once: true, passive: true });
			}
			window.addEventListener(
				'load',
				() => {
					setTimeout(boot, 10000);
				},
				{ once: true },
			);
		</script>
	)
}
