{
  "name": "theapps-mcp",
  "version": "0.2.0",
  "description": "MCP server and Agent Skills for Apps API (theapps.jp)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "theapps-mcp": "bin/theapps-mcp.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run scripts/build.ts",
    "pack:skill": "node ./scripts/pack-skill.mjs",
    "pack:skills": "node ./scripts/pack-skill.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ tests/ scripts/",
    "format": "biome format --write src/ tests/ scripts/",
    "check": "biome check src/ tests/ scripts/",
    "test": "bun test",
    "inspector": "bunx @modelcontextprotocol/inspector bun run src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "theapps",
    "apps-api",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jammaru/theapps-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jammaru/theapps-mcp/issues"
  },
  "homepage": "https://github.com/jammaru/theapps-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/prompts": "^2.4.9",
    "bun-types": "^1.3.14",
    "typescript": "5.9.3"
  }
}
