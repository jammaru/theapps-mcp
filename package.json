{
  "name": "apps-mcp",
  "version": "0.1.0",
  "description": "Unofficial Model Context Protocol server for theapps.jp Apps API",
  "type": "module",
  "license": "MIT",
  "bin": {
    "apps-mcp": "./bin/apps-mcp.js"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run check && bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ tests/ scripts/",
    "format": "biome format --write src/ tests/ scripts/",
    "check": "biome check src/ tests/ scripts/",
    "test": "bun test",
    "inspector": "bunx @modelcontextprotocol/inspector bun run src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "theapps",
    "apps-api",
    "unofficial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/manmaru-ai/apps-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/prompts": "^2.4.9",
    "bun-types": "^1.3.14",
    "typescript": "5.9.3"
  }
}
