# Apps-mcp 用の環境変数例
# 実際の値を Git にコミットしないでください

APPS_APP_ID=
APPS_APP_SECRET=

# 任意。未設定時はトークンを自動取得・更新します
# APPS_ACCESS_TOKEN=

# 既定: https://api.theapps.jp （変更には APPS_MCP_ALLOW_CUSTOM_BASE_URL=true が必要）
# APPS_API_BASE_URL=https://api.theapps.jp
# APPS_MCP_ALLOW_CUSTOM_BASE_URL=false

# 書き込みツールを有効化する場合のみ true
# APPS_MCP_ALLOW_WRITE=false

# APPS_MCP_TIMEOUT_MS=30000

# --- website/ (Astro, optional) ---
# Google Analytics 4. Empty = disabled. Forks should set their own ID.
# See website/.env.example
# PUBLIC_GOOGLE_ANALYTICS_ID=
